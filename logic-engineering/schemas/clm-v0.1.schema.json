{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/logic-engineering/clm-v0.1.schema.json",
  "title": "规范逻辑模型 CLM v0.1",
  "type": "object",
  "required": ["clm"],
  "additionalProperties": false,
  "properties": {
    "clm": {
      "type": "object",
      "required": ["schema_version", "id", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "0.1" },
        "id": { "$ref": "#/$defs/semanticId" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "canonical"] },
        "domain": { "type": "array", "items": { "$ref": "#/$defs/domainNode" }, "default": [] },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/ruleNode" }, "default": [] },
        "behaviors": { "type": "array", "items": { "$ref": "#/$defs/behaviorNode" }, "default": [] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/actionNode" }, "default": [] },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decisionNode" }, "default": [] },
        "state_machines": { "type": "array", "items": { "$ref": "#/$defs/stateMachineNode" }, "default": [] },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effectNode" }, "default": [] },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraintNode" }, "default": [] },
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenarioNode" }, "default": [] },
        "primitives": { "type": "array", "items": { "$ref": "#/$defs/primitiveNode" }, "default": [] },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" }, "default": [] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceNode" }, "default": [] }
      }
    }
  },
  "$defs": {
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-zA-Z0-9_]+)+$"
    },
    "status": { "enum": ["candidate", "canonical", "deprecated"] },
    "origin": { "enum": ["observed", "intended", "user_defined", "generated"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "baseNode": {
      "type": "object",
      "required": ["id", "kind", "name", "status", "origin", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/semanticId" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "origin": { "$ref": "#/$defs/origin" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" }, "uniqueItems": true },
        "annotations": { "type": "object" }
      }
    },
    "refValue": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": { "ref": { "type": "string", "minLength": 1 } }
    },
    "literalValue": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "integer", "boolean", "null"] }
      }
    },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/refValue" },
        { "$ref": "#/$defs/literalValue" },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": { "values": { "type": "array", "items": { "type": ["string", "number", "integer", "boolean"] } } }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "additionalProperties": false,
          "properties": {
            "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in"] },
            "left": { "$ref": "#/$defs/value" },
            "right": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["op", "items"],
          "additionalProperties": false,
          "properties": {
            "op": { "enum": ["all", "any"] },
            "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          }
        },
        {
          "type": "object",
          "required": ["op", "item"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "not" },
            "item": { "$ref": "#/$defs/condition" }
          }
        },
        {
          "type": "object",
          "required": ["op", "target"],
          "additionalProperties": false,
          "properties": {
            "op": { "enum": ["exists", "not_exists"] },
            "target": { "$ref": "#/$defs/value" }
          }
        }
      ]
    },
    "domainNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["entity", "value_type", "enum", "relationship"] },
            "fields": { "type": "array", "items": { "type": "object" } },
            "values": { "type": "array", "items": { "type": ["string", "number"] }, "uniqueItems": true },
            "constraints": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "ruleNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "condition"],
          "properties": {
            "kind": { "const": "rule" },
            "condition": { "$ref": "#/$defs/condition" },
            "failure_ref": { "$ref": "#/$defs/semanticId" }
          }
        }
      ]
    },
    "behaviorNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "behavior" },
            "inputs": { "type": "array", "items": { "type": "object" } },
            "precondition_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "flow_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "output_refs": { "type": "array", "items": { "type": "string" } },
            "failure_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "postcondition_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
          }
        }
      ]
    },
    "actionNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "operation"],
          "properties": {
            "kind": { "const": "action" },
            "operation": { "enum": ["assign", "create", "update", "delete", "invoke", "emit", "persist", "return", "foreach"] },
            "target": { "$ref": "#/$defs/value" },
            "value": { "$ref": "#/$defs/value" },
            "target_ref": { "type": "string" },
            "arguments": { "type": "object" },
            "collection": { "$ref": "#/$defs/value" },
            "item_name": { "type": "string" },
            "when": { "$ref": "#/$defs/condition" },
            "do_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "effect_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
          }
        }
      ]
    },
    "decisionCase": {
      "type": "object",
      "required": ["when", "then_refs"],
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "then_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
      }
    },
    "decisionNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "decision" },
            "condition": { "$ref": "#/$defs/condition" },
            "then_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "else_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "cases": { "type": "array", "items": { "$ref": "#/$defs/decisionCase" } },
            "default_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
          }
        }
      ]
    },
    "transition": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "from", "to", "trigger_ref"],
          "properties": {
            "kind": { "const": "transition" },
            "from": { "type": "string" },
            "to": { "type": "string" },
            "trigger_ref": { "$ref": "#/$defs/semanticId" },
            "guard_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "effect_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } }
          }
        }
      ]
    },
    "stateMachineNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "states"],
          "properties": {
            "kind": { "const": "state_machine" },
            "state_type_ref": { "type": "string" },
            "states": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
            "initial_states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "terminal_states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
          }
        }
      ]
    },
    "effectNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "effect_type"],
          "properties": {
            "kind": { "const": "effect" },
            "effect_type": { "enum": ["read", "write", "persist", "external_call", "emit", "schedule", "cache_read", "cache_write"] },
            "resource_ref": { "type": "string" },
            "operation": { "type": "string" },
            "properties": { "type": "object" }
          }
        }
      ]
    },
    "constraintNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "constraint_type"],
          "properties": {
            "kind": { "const": "constraint" },
            "constraint_type": { "enum": ["precondition", "postcondition", "invariant", "forbidden_transition", "uniqueness", "cardinality", "ordering", "temporal", "concurrency", "atomicity", "idempotency"] },
            "condition": { "$ref": "#/$defs/condition" },
            "members": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
            "failure_policy": { "type": "string" },
            "trigger_ref": { "type": "string" },
            "requirement_ref": { "type": "string" },
            "relation": { "type": "string" },
            "time_bound": { "type": "string" },
            "resource_ref": { "type": "string" },
            "policy": { "type": "string" }
          }
        }
      ]
    },
    "scenarioAssignment": {
      "type": "object",
      "required": ["target", "value"],
      "properties": {
        "target": { "$ref": "#/$defs/value" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "scenarioAssertion": {
      "type": "object",
      "required": ["target", "assertion", "value"],
      "properties": {
        "target": { "$ref": "#/$defs/value" },
        "assertion": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "exists", "not_exists"] },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "scenarioNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "when_ref"],
          "properties": {
            "kind": { "const": "scenario" },
            "given": { "type": "array", "items": { "$ref": "#/$defs/scenarioAssignment" } },
            "when_ref": { "$ref": "#/$defs/semanticId" },
            "then": { "type": "array", "items": { "$ref": "#/$defs/scenarioAssertion" } }
          }
        }
      ]
    },
    "primitiveNode": {
      "allOf": [
        { "$ref": "#/$defs/baseNode" },
        {
          "type": "object",
          "required": ["kind", "contract"],
          "properties": {
            "kind": { "const": "primitive" },
            "contract": { "type": "object" },
            "binding_refs": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": ["source_ref", "relation", "target_ref"],
      "additionalProperties": false,
      "properties": {
        "source_ref": { "$ref": "#/$defs/semanticId" },
        "relation": { "enum": ["REQUIRES", "INVOKES", "READS", "WRITES", "TRANSITIONS", "EMITS", "HANDLES", "GUARANTEES", "CONSTRAINED_BY", "USES_PRIMITIVE", "DERIVED_FROM", "EVIDENCED_BY"] },
        "target_ref": { "$ref": "#/$defs/semanticId" }
      }
    },
    "evidenceNode": {
      "type": "object",
      "required": ["id", "kind", "classification", "supports_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/semanticId" },
        "kind": { "const": "evidence" },
        "classification": { "enum": ["observed", "inferred", "assumed", "unknown"] },
        "source": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "path": { "type": "string" },
            "symbol": { "type": "string" },
            "lines": { "type": "string" }
          }
        },
        "supports_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/semanticId" } },
        "based_on_refs": { "type": "array", "items": { "$ref": "#/$defs/semanticId" } },
        "assumption": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
