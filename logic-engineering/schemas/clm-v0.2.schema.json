{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/logic-engineering/clm-v0.2.schema.json",
  "title": "规范逻辑模型 CLM v0.2",
  "type": "object",
  "required": ["clm"],
  "properties": {"clm": {"$ref": "#/$defs/root"}},
  "additionalProperties": false,
  "$defs": {
    "semanticId": {"type": "string", "minLength": 3},
    "nodeBase": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"$ref": "#/$defs/semanticId"}, "kind": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "status": {"type": "string"}, "origin": {"type": "string"}, "confidence": {"type": "number"}, "tags": {"type": "array"}, "references": {"type": "array"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "scalarTypedValue": {"type": "object", "oneOf": [{"required": ["ref"], "properties": {"ref": {"type": "string"}}, "additionalProperties": false}, {"required": ["literal"], "properties": {"literal": {}}, "additionalProperties": false}, {"required": ["enum"], "properties": {"enum": {"type": "object", "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}, {"required": ["null"], "properties": {"null": {"const": true}}, "additionalProperties": false}]},
    "typedValue": {"oneOf": [
      {"$ref": "#/$defs/scalarTypedValue"},
      {"type": "object", "required": ["set"], "properties": {"set": {"type": "array", "items": {"$ref": "#/$defs/scalarTypedValue"}}}, "additionalProperties": false},
      {"type": "object", "required": ["list"], "properties": {"list": {"type": "array", "items": {"$ref": "#/$defs/typedValue"}}}, "additionalProperties": false},
      {"type": "object", "required": ["object"], "properties": {"object": {"type": "object", "required": ["type", "fields"], "properties": {"type": {"$ref": "#/$defs/semanticId"}, "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/typedValue"}}}, "additionalProperties": false}}, "additionalProperties": false}
    ]},
    "effectArgument": {"type": "object", "required": ["name", "value"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "value": {"$ref": "#/$defs/typedValue"}}, "additionalProperties": false},
    "expression": {"type": "object", "oneOf": [{"required": ["op", "items"], "properties": {"op": {"enum": ["all", "any"]}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false}, {"required": ["op", "item"], "properties": {"op": {"const": "not"}, "item": {"$ref": "#/$defs/expression"}}, "additionalProperties": false}, {"required": ["op", "left", "right"], "properties": {"op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge", "in", "not_in"]}, "left": {"$ref": "#/$defs/scalarTypedValue"}, "right": {"$ref": "#/$defs/typedValue"}}, "additionalProperties": false}]},
    "assignment": {"type": "object", "required": ["target", "value"], "properties": {"target": {"$ref": "#/$defs/scalarTypedValue"}, "value": {"$ref": "#/$defs/typedValue"}}, "additionalProperties": false},
    "expectation": {"oneOf": [{"$ref": "#/$defs/assignment"}, {"type": "object", "required": ["expression"], "properties": {"expression": {"$ref": "#/$defs/expression"}}, "additionalProperties": false}]},
    "field": {"type": "object", "required": ["id", "type"], "properties": {"id": {"$ref": "#/$defs/semanticId"}, "type": {"type": "string"}, "nullable": {"type": "boolean"}, "cardinality": {"enum": ["one", "many"]}}, "additionalProperties": true},
    "domainNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"oneOf": [{"properties": {"kind": {"const": "entity"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}}, "required": ["fields"]}, {"properties": {"kind": {"const": "enum"}, "values": {"type": "array", "minItems": 1, "uniqueItems": true}}, "required": ["values"]}, {"properties": {"kind": {"const": "value_type"}, "base_type": {"type": "string"}}}, {"properties": {"kind": {"const": "relationship"}}}]}]},
    "behaviorNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"const": "behavior"}, "inputs": {"type": "array"}, "preconditions": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}, "flow": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}, "outputs": {"type": "array"}, "failures": {"type": "array", "items": {"type": "string"}}, "postconditions": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}}}]},
    "ruleNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"const": "rule"}, "expression": {"$ref": "#/$defs/expression"}, "failure": {"type": "string"}}, "required": ["expression"]}]},
    "decisionNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"const": "decision"}, "when": {"$ref": "#/$defs/expression"}, "then": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}, "else": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}}, "required": ["when", "then"]}]},
    "actionNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"enum": ["action", "foreach"]}, "operation": {"type": "string"}, "target": {"$ref": "#/$defs/scalarTypedValue"}, "value": {"$ref": "#/$defs/typedValue"}, "effects": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}, "when": {"$ref": "#/$defs/expression"}, "collection": {"$ref": "#/$defs/scalarTypedValue"}, "item": {"type": "string"}, "do": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}}, "allOf": [{"if": {"properties": {"kind": {"const": "action"}, "operation": {"const": "assign"}}, "required": ["kind", "operation"]}, "then": {"required": ["target", "value"]}}, {"if": {"properties": {"kind": {"const": "foreach"}}, "required": ["kind"]}, "then": {"required": ["collection", "item", "do"]}}]}]},
    "stateNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"oneOf": [{"properties": {"kind": {"const": "state_machine"}, "states": {"type": "array", "minItems": 1, "uniqueItems": true}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}}, "required": ["states", "transitions"]}, {"properties": {"kind": {"const": "transition"}, "from": {}, "to": {}, "trigger": {"$ref": "#/$defs/semanticId"}, "guard": {"$ref": "#/$defs/expression"}}, "required": ["from", "to", "trigger"]}]}]},
    "effectNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"enum": ["effect", "read", "write", "persist", "external_call", "emit", "schedule", "cache_read", "cache_write"]}, "resource": {"type": "string"}, "system": {"type": "string"}, "operation": {"type": "string"}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/effectArgument"}}, "failure_refs": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"kind": {"const": "external_call"}}, "required": ["kind"]}, "then": {"required": ["system", "operation"]}}]}]},
    "constraintNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"enum": ["constraint", "precondition", "postcondition", "invariant", "uniqueness", "cardinality", "ordering", "temporal", "concurrency", "atomicity", "idempotency", "retry", "forbidden_transition"]}, "expression": {"$ref": "#/$defs/expression"}, "behavior_ref": {"$ref": "#/$defs/semanticId"}, "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semanticId"}}}, "allOf": [{"if": {"properties": {"kind": {"const": "atomicity"}}, "required": ["kind"]}, "then": {"required": ["behavior_ref", "members"]}}]}]},
    "scenarioNode": {"allOf": [{"$ref": "#/$defs/nodeBase"}, {"properties": {"kind": {"const": "scenario"}, "given": {"type": "array", "items": {"$ref": "#/$defs/assignment"}}, "when": {"type": "array", "items": {"$ref": "#/$defs/semanticId"}}, "then": {"type": "array", "items": {"$ref": "#/$defs/expectation"}}}, "required": ["given", "when", "then"]}]},
    "genericNode": {"$ref": "#/$defs/nodeBase"},
    "relation": {"type": "object", "required": ["source", "relation", "target"], "properties": {"source": {"$ref": "#/$defs/semanticId"}, "relation": {"type": "string"}, "target": {"$ref": "#/$defs/semanticId"}}, "additionalProperties": true},
    "root": {"type": "object", "required": ["id", "version", "name", "domain", "behaviors", "rules", "decisions", "actions", "states", "effects", "constraints", "scenarios", "primitives", "relations", "evidence"], "properties": {"id": {"type": "string"}, "version": {"const": "0.2"}, "name": {"type": "string"}, "domain": {"type": "array", "items": {"$ref": "#/$defs/domainNode"}}, "behaviors": {"type": "array", "items": {"$ref": "#/$defs/behaviorNode"}}, "rules": {"type": "array", "items": {"$ref": "#/$defs/ruleNode"}}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/decisionNode"}}, "actions": {"type": "array", "items": {"$ref": "#/$defs/actionNode"}}, "states": {"type": "array", "items": {"$ref": "#/$defs/stateNode"}}, "effects": {"type": "array", "items": {"$ref": "#/$defs/effectNode"}}, "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraintNode"}}, "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenarioNode"}}, "primitives": {"type": "array", "items": {"$ref": "#/$defs/genericNode"}}, "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}, "evidence": {"type": "array"}}, "additionalProperties": true}
  }
}
