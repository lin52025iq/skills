{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/logic-engineering/semantic-change-set-v0.2.schema.json",
  "title": "语义变更集 v0.2",
  "type": "object",
  "required": ["change_set_id", "intent", "operations", "behavior_change_level", "verification_required"],
  "additionalProperties": false,
  "properties": {
    "change_set_id": { "type": "string", "pattern": "^change\\.[A-Za-z0-9_.-]+$" },
    "intent": { "type": "string", "minLength": 1 },
    "reason": { "type": "string" },
    "source": { "enum": ["user_request", "optimization_proposal", "legacy_repair", "human_review", "generated"] },
    "behavior_change_level": { "enum": ["O1_NORMALIZATION", "O2_REFACTORING", "O3_ROBUSTNESS", "O4_BUSINESS_CHANGE"] },
    "base_model_version": { "type": ["string", "integer"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "verification_required": {
      "type": "array",
      "items": {
        "enum": ["schema", "type_check", "semantic_consistency", "semantic_equivalence", "scenario_tests", "boundary_tests", "property_tests", "state_machine_check", "formal_check", "implementation_conformance", "human_confirmation"]
      },
      "uniqueItems": true
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "semanticId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]+$" },
    "operation": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation_id": { "type": "string" },
        "operation": {
          "enum": ["ADD_NODE", "REMOVE_NODE", "UPDATE_FIELD", "ADD_MEMBER", "REMOVE_MEMBER", "ADD_RELATION", "REMOVE_RELATION", "REPLACE_REFERENCE"]
        },
        "target_semantic_id": { "$ref": "#/$defs/semanticId" },
        "collection": { "type": "string" },
        "field_path": { "type": "string" },
        "before": {},
        "after": {},
        "value": {},
        "source": { "$ref": "#/$defs/semanticId" },
        "relation": { "type": "string" },
        "target": { "$ref": "#/$defs/semanticId" }
      },
      "required": ["operation"],
      "allOf": [
        {
          "if": { "properties": { "operation": { "enum": ["REMOVE_NODE", "UPDATE_FIELD", "ADD_MEMBER", "REMOVE_MEMBER", "REPLACE_REFERENCE"] } } },
          "then": { "required": ["target_semantic_id"] }
        },
        {
          "if": { "properties": { "operation": { "const": "ADD_NODE" } } },
          "then": { "required": ["collection", "after"] }
        },
        {
          "if": { "properties": { "operation": { "enum": ["ADD_RELATION", "REMOVE_RELATION"] } } },
          "then": { "required": ["source", "relation", "target"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
