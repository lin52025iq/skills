{
  "suite": "typescript-generator-v0.1",
  "cases": [
    {
      "id": "ts.generator.requires-valid-iir",
      "expect": [
        "IIR blocking unresolved 非空时拒绝生成",
        "Target Profile language 不是 TypeScript 时拒绝生成",
        "首个参考目标 persistence 不是 SQLite 时拒绝生成"
      ]
    },
    {
      "id": "ts.generator.interfaces",
      "expect": [
        "repository_contracts 生成 TypeScript interface",
        "external_ports 生成 TypeScript interface",
        "SQLite adapter 只生成 contract/TODO，不猜表结构"
      ]
    },
    {
      "id": "ts.generator.usecase-order",
      "expect": [
        "Use Case 执行顺序保留 guards → steps",
        "依赖只来自 IIR dependencies",
        "生成物保留 Semantic ID 可追踪信息"
      ]
    },
    {
      "id": "ts.generator.tests",
      "expect": [
        "测试骨架只消费 Target Test Plan",
        "使用 Vitest",
        "Given/When/Expect 被保留",
        "未知 fixture 只生成 TODO，不虚构领域数据"
      ]
    },
    {
      "id": "ts.generator.manifest",
      "expect": [
        "manifest generator=typescript-v0.1",
        "manifest 包含 source_clm/source_semantic_hash/iir_version/target_profile",
        "每个 artifact 有 path/semantic_refs/content_hash",
        "Node manifest verifier 能检测人工漂移"
      ]
    }
  ]
}
