{
  "clm": {
    "id": "module.order.atomicity",
    "version": "0.2",
    "name": "订单取消事务示例",
    "domain": [
      {
        "id": "domain.order_status",
        "kind": "enum",
        "name": "订单状态",
        "values": ["PENDING", "CANCELLING", "CANCELLED"]
      },
      {
        "id": "domain.order",
        "kind": "entity",
        "name": "订单",
        "fields": [
          {"id": "domain.order.id", "type": "string", "nullable": false},
          {"id": "domain.order.status", "type": "domain.order_status", "nullable": false},
          {"id": "domain.order.owner_id", "type": "string", "nullable": false}
        ]
      }
    ],
    "behaviors": [
      {
        "id": "behavior.order.cancel_atomic",
        "kind": "behavior",
        "name": "原子取消订单",
        "preconditions": [],
        "flow": [
          "action.order.cancel.mark_cancelling",
          "action.order.cancel.mark_cancelled"
        ],
        "postconditions": []
      }
    ],
    "rules": [],
    "decisions": [],
    "actions": [
      {
        "id": "action.order.cancel.mark_cancelling",
        "kind": "action",
        "name": "标记取消中",
        "operation": "assign",
        "target": {"ref": "domain.order.status"},
        "value": {"enum": {"type": "domain.order_status", "value": "CANCELLING"}},
        "effects": ["effect.order.cancel.save_cancelling"]
      },
      {
        "id": "action.order.cancel.mark_cancelled",
        "kind": "action",
        "name": "标记已取消",
        "operation": "assign",
        "target": {"ref": "domain.order.status"},
        "value": {"enum": {"type": "domain.order_status", "value": "CANCELLED"}},
        "effects": ["effect.order.cancel.save_cancelled"]
      }
    ],
    "states": [],
    "effects": [
      {
        "id": "effect.order.cancel.save_cancelling",
        "kind": "write",
        "resource": "domain.order.status"
      },
      {
        "id": "effect.order.cancel.save_cancelled",
        "kind": "write",
        "resource": "domain.order.status"
      }
    ],
    "constraints": [
      {
        "id": "constraint.order.cancel.atomic",
        "kind": "atomicity",
        "name": "取消状态写入必须原子完成",
        "behavior_ref": "behavior.order.cancel_atomic",
        "members": [
          "action.order.cancel.mark_cancelling",
          "action.order.cancel.mark_cancelled"
        ]
      }
    ],
    "scenarios": [
      {
        "id": "scenario.order.cancel.atomic",
        "kind": "scenario",
        "name": "订单原子取消",
        "given": [
          {"target": {"ref": "domain.order.id"}, "value": {"literal": "order-1"}},
          {"target": {"ref": "domain.order.status"}, "value": {"enum": {"type": "domain.order_status", "value": "PENDING"}}},
          {"target": {"ref": "domain.order.owner_id"}, "value": {"literal": "user-1"}}
        ],
        "when": ["behavior.order.cancel_atomic"],
        "then": [
          {"target": {"ref": "domain.order.status"}, "value": {"enum": {"type": "domain.order_status", "value": "CANCELLED"}}
        ]
      }
    ],
    "primitives": [],
    "relations": [],
    "evidence": []
  }
}
